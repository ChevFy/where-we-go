@{
    var isAuthenticated = ViewBag.IsAuth ?? false;
    var userData = Model as where_we_go.DTO.UserResponseDto;
}

<nav class="nav-bar">
    <div class="nav-left-container">
        <a asp-controller="Home" asp-action="Index">
            <img src="/images/wherewego-logo.svg" class="logo-icon">
        </a>
        <div class="nav-menu">
            <ul class="nav-list">
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Post" asp-action="PostCreate" class="nav-link">Create Activity</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="GroupChat"
                           asp-action="MyChats"
                           class="nav-link">
                            My Chats
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Notification"
                           asp-action="Index"
                           class="nav-link nav-link-notification">
                            Notifications
                            @if (ViewBag.UnReadCount is int unRead && unRead > 0)
                            {
                                <span class="nav-badge">@unRead</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="hbg-wrapper">
            @if (isAuthenticated)
            {
                @await Component.InvokeAsync("HamburgerMenu", new
                {
                    items = new List<where_we_go.ViewComponents.NavItem> {
                        new() { Text = "Home", Href = "/" },
                        new() { Text = "Create Activity", Href = "/Post/PostCreate" },
                        new() { Text = "My Chats", Href = "/GroupChat/MyChats" },
                        new() {
                            Text = (ViewBag.UnReadCount is int unRead && unRead > 0)
                                ? $"Notifications ({unRead})"
                                : "Notifications",
                            Href = "/Notification"
                        },
                    }
                })
            }
        </div>
    </div>

    <div class="login-container">

        @if (isAuthenticated && userData != null)
        {
            <a asp-controller="User" asp-action="UserProfile" asp-route-username=@userData?.UserName>
                <div class="login-text">
                    @* <span class="user-name">@userData.Name</span> *@
                    @* <a asp-controller="Auth" asp-action="Logout">Logout</a> *@
                </div>
                <img src="@userData?.ProfileUrl" class="login-icon" />
            </a>

        }
        else
        {
            <a asp-controller="Auth" asp-action="Login">
                <img src="/images/non-profile-login.svg" class="login-icon" />
            </a>
            <a asp-controller="Auth" asp-action="Login" class="login-link">Sign In</a>
        }




    </div>

</nav>
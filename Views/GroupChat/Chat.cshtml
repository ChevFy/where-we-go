@model where_we_go.DTO.GroupChatViewDto

@{
    ViewData["Title"] = "Group Chat";
}

@section Styles
{
<link rel="stylesheet" href="~/css/GroupChat.css" />
@* Import component css *@
    <link rel="stylesheet" href="~/css/components/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/mainbutton.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/hamburgermenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/inputbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/Select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/Filter.css" asp-append-version="true" />}

<header>
    @await Component.InvokeAsync("Navbar")
</header>


<div class="chat-page">
    @* <div class="chat-header">
        <h2>@Model.name Chat</h2> 
    </div> *@


    <div class="chat-messages">
@foreach (var m in Model.messages)
{
    if (m.is_me)
    {
        <div class="message-row me">
            <div class="message-content">
                <div class="message-bubble">
                    <div class="message-text">@m.message</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="message-row other">
            <img class="chat-avatar" src="@m.sender_avatar" alt="@m.sender_name" />
            <div class="message-content">
                <div class="sender">@m.sender_name</div>
                <div class="message-bubble">
                    <div class="message-text">@m.message</div>
                    <div class="message-time" data-utc="@m.sent_at.ToString("o")"></div>
                </div>
            </div>
        </div>
    }
}
</div>

    <div class="chat-input">
        <form asp-action="SendMessage" asp-controller="GroupChat" method="post" style="display:flex; width:100%">
            @Html.AntiForgeryToken()
            <input type="hidden" name="group_chat_id" value="@Model.group_chat_id" />
            <input type="text" name="message" placeholder="Type your message..." required style="flex:1;" />
            <button type="submit" class="btn" style="margin-left:.5rem;">Send</button>
        </form>
    </div>

</div>

@section Scripts {
    <script>
        (function() {
            const messagesDiv = document.querySelector('.chat-messages');

            // convert server-rendered UTC times to local
            document.querySelectorAll('.message-time[data-utc]').forEach(function(el) {
                el.textContent = new Date(el.dataset.utc).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
            });
            if (messagesDiv) {
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }
        })();
    </script>
}
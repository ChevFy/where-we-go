@model where_we_go.DTO.PostDetailDto
@using System.Security.Claims

@{
    // Get the ID of the person currently looking at the page
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@{
    ViewData["Title"] = "Post Page";

    var isOwner = User.Identity?.IsAuthenticated == true && currentUserId == Model.UserId;
    var ownerFilterStatus = ((string?)ViewBag.OwnerFilterStatus ?? "pending").ToLower();
    var ownerApplicants = ViewBag.OwnerApplicants as List<where_we_go.DTO.ApplicantDto> ?? new
List<where_we_go.DTO.ApplicantDto>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/postdetail.css" asp-append-version="true" />

    @* Import component css *@
    <link rel="stylesheet" href="~/css/components/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/mainbutton.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/hamburgermenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/footer.css" asp-append-version="true" />
}

<header>
    @await Component.InvokeAsync("Navbar")
</header>

<div class="post-bg-container">
    <div class="post-container">
        <img class="post-thumbnail" src=@Model.PostImgURL alt="Thumbnail">

        <h2 class="post-title">@Model.Title</h2>
        <p class="post-status @Model.Status?.ToLower()">@Model.Status</p>

        <div class="post-location">
            <a target="_blank"
                   href="https://www.google.com/maps/search/?api=1&query=@Model.Locationlat,@Model.Locationlon">
                @Model.LocationName
            </a>
        </div>

        <div class="post-date">
            <p>📅 @Model.DateDeadlineFormatted</p>
        </div>

        <div class="post-event-date">
            <p>🎉 @Model.EventDateFormatted</p>
        </div>

        <div class="post-population">
            <p>👥 @(Model.CurrentParticipants + 1) / @(Model.MaxParticipants + 1) People</p>
        </div>
        <div class="post-category">
            <ul>
                @if (Model.Categories.Count > 0)
                {
                    @foreach (var category in Model.Categories)
                    {
                        <li>@category.Name</li>
                    }
                }
                else
                {
                    <li>Uncategorized</li>
                }
            </ul>
        </div>

        <div class="post-description">
            <p>@Model.Description</p>
        </div>

        @if (isOwner)
        {
            <div class="owner-manage-panel">
                <h3 class="owner-manage-title">Manage Participants</h3>

                <div class="status-filter-row">
                    <a class="status-filter-btn @(ownerFilterStatus == "pending" ? "active" : "")" asp-controller="Post"
                       asp-action="PostDetail" asp-route-id="@Model.PostId" asp-route-status="pending">Pending</a>
                    <a class="status-filter-btn @(ownerFilterStatus == "approved" ? "active" : "")" asp-controller="Post"
                       asp-action="PostDetail" asp-route-id="@Model.PostId" asp-route-status="approved">Approved</a>
                    <a class="status-filter-btn @(ownerFilterStatus == "rejected" ? "active" : "")" asp-controller="Post"
                       asp-action="PostDetail" asp-route-id="@Model.PostId" asp-route-status="rejected">Rejected</a>
                    <a class="status-filter-btn @(ownerFilterStatus == "withdrawn" ? "active" : "")" asp-controller="Post"
                       asp-action="PostDetail" asp-route-id="@Model.PostId" asp-route-status="withdrawn">Withdrawn</a>
                </div>

                <div class="owner-applicant-list">
                    @if (ownerApplicants.Count == 0)
                    {
                        <p class="applicant-empty">No participants in this status.</p>
                    }
                    else
                    {
                        @foreach (var applicant in ownerApplicants)
                        {
                            <div class="applicant-row">
                                <div class="applicant-row-left">
                                    <div class="row-avatar-wrap">
                                        @if (!string.IsNullOrEmpty(applicant.ProfileImageKey))
                                        {
                                            <img src="@applicant.ProfileImageKey" alt="@applicant.Name" class="row-avatar-image" />
                                        }
                                        else
                                        {
                                            <div class="row-avatar-placeholder">@applicant.Name.Substring(0, 1).ToUpper()</div>
                                        }
                                    </div>
                                    <div class="row-text">
                                        <p class="row-name">@applicant.Name</p>
                                        <p class="row-meta">@applicant.Status</p>
                                    </div>
                                </div>

                                <div class="row-actions">
                                    @if (applicant.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-controller="Post" asp-action="ApproveApplicantForm" method="post">
                                            <input type="hidden" name="postId" value="@Model.PostId" />
                                            <input type="hidden" name="applicantId" value="@applicant.UserId" />
                                            <input type="hidden" name="status" value="@ownerFilterStatus" />
                                            <button type="submit" class="row-action-btn add">Approve</button>
                                        </form>

                                        <form asp-controller="Post" asp-action="RejectApplicantForm" method="post">
                                            <input type="hidden" name="postId" value="@Model.PostId" />
                                            <input type="hidden" name="applicantId" value="@applicant.UserId" />
                                            <input type="hidden" name="status" value="@ownerFilterStatus" />
                                            <button type="submit" class="row-action-btn remove">Reject</button>
                                        </form>
                                    }
                                    else if (applicant.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-controller="Post" asp-action="RemoveParticipantForm" method="post">
                                            <input type="hidden" name="postId" value="@Model.PostId" />
                                            <input type="hidden" name="applicantId" value="@applicant.UserId" />
                                            <input type="hidden" name="status" value="@ownerFilterStatus" />
                                            <button type="submit" class="row-action-btn remove">Remove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="row-action-disabled">Locked</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="participants" style="margin-bottom: 2rem;">
                <div class="participant-avatar owner-highlight" title="@Model.Owner.UserName">
                    @if (!string.IsNullOrEmpty(@Model.Owner.ProfileImgURL))
                    {
                        <a asp-controller="User" asp-action="UserProfile" asp-route-username=@Model.Owner.UserName>
                            <img src="@Model.Owner.ProfileImgURL" />
                        </a>
                    }
                    else
                    {
                        <div class="participant-avatar-placeholder">
                            @Model.Owner?.UserName.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <span class="owner-avatar-tag">Owner</span>
                </div>
                @foreach (var participant in Model.CurrentParticipantsDetail)
                {
                    <div class="participant-avatar" title="@participant.UserName">
                        @if (!string.IsNullOrEmpty(participant.ProfileImgURL))
                        {
                            <a asp-controller="User" asp-action="UserProfile" asp-route-username=@participant.UserName>
                                <img src="@participant.ProfileImgURL" />
                            </a>
                        }
                        else
                        {
                            <div class="participant-avatar-placeholder">
                                @participant.UserName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="join-section">
            @* Check if user is logged in AND not the owner of the post *@
            @if (User.Identity?.IsAuthenticated == true && currentUserId != Model.UserId)
            {
                @if (Model.IsJoined)
                {
                    <form asp-action="LeavePost" asp-controller="Post" asp-route-id="@Model.PostId" method="post" class="btn btn-primary" style="margin-top: 2rem">
                        <button type="submit" class="btn" style="background-color: rgb(243, 49, 49)">Leave Activity</button>
                    </form>
                }
                else if (Model.IsPending)
                {
                    <form asp-action="LeavePost" asp-controller="Post" asp-route-id="@Model.PostId" method="post"
                            onsubmit="return confirm('Withdraw your request to join this activity?');">
                        <button type="submit" class="btn btn-danger">Withdraw Request</button>
                    </form>
                }
                else if (Model.IsRejected)
                {
                    <button type="button" class="btn btn-secondary" disabled>Request Was Rejected</button>
                }
                else if (Model.IsWithdrawn)
                {
                    <button type="button" class="btn btn-secondary" disabled>Cannot Rejoin After Withdrawing</button>
                }
                else
                {
                    <form asp-action="JoinPost" asp-controller="Post" asp-route-id="@Model.PostId" method="post">
                        <button type="submit" class="btn" style="background-color: rgb(96, 241, 28);">Join Activity</button>
                    </form>
                }
            }

            @* Show group chat button for owner or joined user when chat exists *@
            @if (User.Identity?.IsAuthenticated == true && Model.ChatId != null && (isOwner || Model.IsJoined))
            {
                <div style="margin-top:0.5rem">
                    <a asp-controller="GroupChat" asp-action="Chat" asp-route-group_chat_id="@Model.ChatId" class="btn btn-primary">
                        <span class="btn" style="background-color: rgb(32, 162, 255)">💬 Go to Activity Chat</span>
                    </a>
                </div>
            }
        </div>
        @* Only show edit and delete if user is logged in AND they are the creator *@
        @if (isOwner)
        {
            <div class="action-buttons" >
                <a asp-controller="Post" asp-action="PostEdit" asp-route-id="@Model.PostId" class="btn btn-warning">
                    Edit Post
                </a>

                <form asp-action="PostDelete" asp-controller="Post" asp-route-id="@Model.PostId" method="post"
                      onsubmit="return confirm('Do you really want to delete this post?');">
                    <button type="submit" class="btn btn-danger">Delete This Post</button>
                </form>
            </div>
        }
    </div>
</div>